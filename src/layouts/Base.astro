---
/**
 * The document shell. Everything a page needs to be found — by a search engine
 * and by an answer engine — is set here once: canonical, OG, JSON-LD, and a
 * <main> that contains the whole answer in plain HTML with no JS required.
 */
import '../styles/tokens.css';
import kopigi from '../content/lapas/kopigi.json';

interface Props {
  title: string;
  description: string;
  /** Optional JSON-LD; the site-wide Person/WebSite graph is always emitted. */
  schema?: Record<string, unknown>[];
  noindex?: boolean;
  /** 'article' on a piece, so the card and the crawlers classify it correctly. */
  ogType?: 'website' | 'article';
  publishedTime?: Date;
  section?: string;
}
const {
  title, description, schema = [], noindex = false,
  ogType = 'website', publishedTime, section,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const onArticles = Astro.url.pathname.startsWith('/raksti');
const ogImage = new URL('/og.png', Astro.site).href;

const baseGraph = [
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: 'Mārtiņš Auseklis',
    url: 'https://mai.lv',
    jobTitle: 'Programmatūras izstrādātājs',
    knowsLanguage: ['lv', 'en'],
    email: 'martins@mai.lv',
    address: { '@type': 'PostalAddress', addressRegion: 'Zemgale', addressCountry: 'LV' },
    areaServed: { '@type': 'AdministrativeArea', name: 'Jelgava, Jelgavas novads' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'mai.lv',
    url: 'https://mai.lv',
    inLanguage: 'lv',
  },
];
---
<!doctype html>
<html lang="lv">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex" />}

  <meta property="og:type" content={ogType} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:locale" content="lv_LV" />
  <meta property="og:site_name" content="mai.lv" />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <!-- Must describe what public/og.png actually says; regenerate both together
       with tools/og-card.sh. -->
  <meta property="og:image:alt" content="mai.lv — Vienkāršāka ikdiena ar mākslīgo intelektu" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content={ogImage} />
  {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
  {ogType === 'article' && <meta property="article:author" content="Mārtiņš Auseklis" />}
  {section && <meta property="article:section" content={section} />}

  <link rel="icon" href="/favicon.ico" sizes="32x32" />
  <link rel="icon" href="/favicon-32.png" type="image/png" media="(prefers-color-scheme: light)" />
  <link rel="icon" href="/favicon-32-dark.png" type="image/png" media="(prefers-color-scheme: dark)" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="alternate" type="application/rss+xml" title="mai.lv" href="/rss.xml" />

  <script type="application/ld+json" set:html={JSON.stringify([...baseGraph, ...schema])} />
</head>
<body>
  <div class="page">
    <header class="top">
      <a class="wm" href="/">{kopigi.vardzime}</a>
      {/* Two pages, so the nav only ever needs to offer the other one. On the
          articles page that's home; everywhere else it's the articles. */}
      <nav>
        {onArticles
          ? <a href="/">{kopigi.navSakums}</a>
          : <a href="/raksti">{kopigi.navRaksti}</a>}
      </nav>
    </header>

    <main><slot /></main>

    <footer>
      {kopigi.formaAtslega && (
        <section class="sazina">
          <h2>{kopigi.formaVirsraksts}</h2>
          <p class="ievads">{kopigi.formaIevads}</p>
          {/* Our own markup posting to Web3Forms, rather than their iframe — an
              iframe is a separate origin, so no stylesheet of ours can reach
              inside it. This way the form is just part of the page.

              It works with JavaScript off: the plain action/method submit lands
              on Web3Forms' own confirmation page. The script below upgrades that
              to an inline thank-you so the visitor never leaves mai.lv. */}
          <form
            class="forma"
            method="POST"
            action="https://api.web3forms.com/submit"
            data-sazina
            data-paldies={kopigi.formaPeciesuti}
          >
            <input type="hidden" name="access_key" value={kopigi.formaAtslega} />
            <input type="hidden" name="subject" value="Jauna ziņa no mai.lv" />
            <input type="hidden" name="from_name" value="mai.lv" />
            {/* Web3Forms discards anything where this is ticked. Hidden from
                sight and from the tab order, so only a bot fills it. */}
            <input
              type="checkbox"
              name="botcheck"
              class="slepenais"
              tabindex="-1"
              autocomplete="off"
            />

            <label class="lauks">
              <span>{kopigi.formaEpastaLauks}</span>
              <input type="email" name="email" required autocomplete="email" />
            </label>

            <label class="lauks">
              <span>{kopigi.formaZinasLauks}</span>
              <textarea name="message" rows="4" required></textarea>
            </label>

            <button type="submit" class="cta">{kopigi.formaPoga}</button>
            <p class="statuss" data-statuss role="status" aria-live="polite"></p>
          </form>

          <p class="smalkais">
            Nosūtot piekrīti <a href="/privatums">privātuma politikai</a>.
          </p>
        </section>
      )}

      <p class="kajene">{kopigi.kajene} · <a href="/privatums">{kopigi.privatumsSaite}</a></p>
    </footer>
  </div>
</body>
</html>

<style>
  .page{max-width:820px;margin:0 auto;padding:clamp(20px,4vw,32px) clamp(16px,5vw,28px) 0}
  .top{display:flex;align-items:baseline;justify-content:space-between;gap:16px;
    margin-bottom:clamp(32px,6vw,52px)}
  .wm{font-family:var(--display);font-weight:600;font-size:19px;letter-spacing:-.01em;
    text-decoration:none}
  nav{display:flex;gap:18px;font-size:14.5px}
  nav a{color:var(--muted);text-decoration:none;transition:color var(--dur-fast) var(--ease-out)}
  nav a:hover{color:var(--ink)}
  footer{margin-top:clamp(56px,10vw,88px);padding-top:clamp(36px,6vw,56px);
    border-top:1px solid var(--line)}
  footer a{color:var(--muted)}
  .kajene{font-size:13px;color:var(--faint);margin:clamp(36px,6vw,56px) 0 0;text-align:center}

  .sazina{max-width:var(--measure);margin:0 auto;text-align:center}
  .sazina h2{font-size:clamp(19px,4vw,22px);margin:0 0 10px}
  .sazina .ievads{font-size:15px;color:var(--muted);margin:0 auto 24px;max-width:42ch}
  .forma{display:flex;flex-direction:column;gap:16px;text-align:left}
  .lauks{display:flex;flex-direction:column;gap:7px}
  .lauks span{font-size:13.5px;color:var(--muted)}
  .forma input[type=email],.forma textarea{
    font-family:inherit;font-size:16px;color:var(--ink);
    background:var(--surface);border:1px solid var(--line);border-radius:var(--r-sm);
    padding:13px 14px;width:100%;
    transition:border-color var(--dur-fast) var(--ease-out)}
  .forma textarea{resize:vertical;min-height:110px}
  .forma input[type=email]:focus,.forma textarea:focus{
    outline:none;border-color:var(--faint)}
  .forma ::placeholder{color:var(--faint)}

  /* iOS paints autofilled fields with its own near-black text on our dark
     surface, which reads as an empty box. Only -webkit-text-fill-color moves
     the text; the inset shadow is the only way to repaint the background. */
  .forma input:-webkit-autofill,
  .forma input:-webkit-autofill:focus{
    -webkit-text-fill-color:var(--ink);
    box-shadow:0 0 0 100px var(--surface) inset;
    caret-color:var(--ink)}

  /* Centred, not left-aligned: the section around it is centred, and the button
     reads as the section's conclusion rather than the last field's neighbour. */
  .forma .cta{align-self:center}
  /* Off-screen rather than display:none — some bots skip hidden inputs. */
  .slepenais{position:absolute;left:-9999px;width:1px;height:1px;opacity:0}
  .statuss{font-size:14px;color:var(--muted);margin:0;min-height:1px}
  .statuss[data-kluda]{color:var(--brand)}
  /* After a successful send the fields go, the thank-you stays. */
  .forma[data-nosutits] .lauks,.forma[data-nosutits] .cta{display:none}
  .forma[data-nosutits] .statuss{color:var(--ink);font-size:15px}

  .sazina .smalkais{font-size:12px;color:var(--faint);margin:12px 0 0}
</style>

<script>
  // Upgrade the plain form POST into a background send, so the visitor gets a
  // thank-you in place instead of being bounced to Web3Forms' own page. With
  // JavaScript off none of this runs and the ordinary submit still works.
  const forma = document.querySelector<HTMLFormElement>('form[data-sazina]');

  forma?.addEventListener('submit', async (notikums) => {
    notikums.preventDefault();

    const poga = forma.querySelector<HTMLButtonElement>('button[type=submit]');
    const statuss = forma.querySelector<HTMLParagraphElement>('[data-statuss]');
    if (!poga || !statuss) return;

    const sakotnejais = poga.textContent;
    poga.disabled = true;
    poga.textContent = 'Sūta…';
    statuss.textContent = '';
    delete statuss.dataset.kluda;

    try {
      const atbilde = await fetch(forma.action, {
        method: 'POST',
        headers: { Accept: 'application/json' },
        body: new FormData(forma),
      });
      if (!atbilde.ok) throw new Error(String(atbilde.status));

      // Hide the fields rather than replacing the form: an element built here
      // would not carry Astro's scoped-style attribute, so it would render
      // unstyled. The status paragraph is already in the template.
      forma.dataset.nosutits = '';
      statuss.textContent = forma.dataset.paldies || 'Paldies — ziņa aizgāja.';
    } catch {
      poga.disabled = false;
      poga.textContent = sakotnejais;
      statuss.dataset.kluda = '';
      statuss.textContent = 'Neizdevās nosūtīt. Raksti uz martins@mai.lv.';
    }
  });
</script>
