---
import Base from '../../layouts/Base.astro';
import { allArticles, formatDate } from '../../lib/articles';
import { render } from 'astro:content';

// Only public pieces get a page. Inside the gate there is no file to find.
export async function getStaticPaths() {
  const raksti = await allArticles();
  return raksti.map((r) => ({ params: { id: r.id }, props: { raksts: r } }));
}

const { raksts } = Astro.props;
const { Content } = await render(raksts);

const url = new URL(`/raksti/${raksts.id}/`, Astro.site).href;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: raksts.data.virsraksts,
    description: raksts.data.kopsavilkums,
    datePublished: raksts.data.datums.toISOString(),
    dateModified: raksts.data.datums.toISOString(),
    inLanguage: 'lv',
    url,
    mainEntityOfPage: { '@type': 'WebPage', '@id': url },
    image: new URL('/og.png', Astro.site).href,
    author: { '@type': 'Person', name: 'Mārtiņš Auseklis', url: 'https://mai.lv' },
    publisher: { '@type': 'Person', name: 'Mārtiņš Auseklis', url: 'https://mai.lv' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Sākums', item: new URL('/', Astro.site).href },
      { '@type': 'ListItem', position: 2, name: 'Raksti', item: new URL('/raksti/', Astro.site).href },
      { '@type': 'ListItem', position: 3, name: raksts.data.virsraksts, item: url },
    ],
  },
];
---
<Base
  title={`${raksts.data.virsraksts} — mai.lv`}
  description={raksts.data.kopsavilkums}
  schema={schema}
  ogType="article"
  publishedTime={raksts.data.datums}
>
  <article>
    <h1>{raksts.data.virsraksts}</h1>
    <p class="formatDate">{formatDate(raksts.data.datums)}</p>
    <div class="proza"><Content /></div>
  </article>
  <p class="atpakal"><a href="/raksti">← Visi raksti</a></p>
</Base>

<style>
  h1{max-width:20ch;margin-bottom:8px}
  .formatDate{font-size:12.5px;color:var(--faint);margin-bottom:30px}
  /* Every element the editor can produce needs a rule here. Markdown arrives as
     plain HTML with no classes, and Astro's scoped styles can't reach markdown
     it rendered — hence :global on each. Anything missing falls back to browser
     defaults, which on a dark background reads as a bug. */
  .proza{max-width:var(--measure)}
  .proza :global(p){font-size:16.5px;line-height:1.75;margin:0 0 16px}
  .proza :global(h2){font-size:20px;margin:32px 0 12px}
  .proza :global(h3){font-size:17px;margin:26px 0 10px;color:var(--ink)}
  .proza :global(ul),.proza :global(ol){margin:0 0 16px;padding-left:22px;color:var(--muted)}
  .proza :global(li){margin:0 0 8px;font-size:16.5px;line-height:1.7}
  .proza :global(li)::marker{color:var(--faint)}
  .proza :global(strong){color:var(--ink);font-weight:650}
  .proza :global(em){font-style:italic}
  .proza :global(del){color:var(--faint)}
  .proza :global(a){color:var(--ink);text-decoration:underline;
    text-decoration-color:var(--brand);text-underline-offset:3px}
  .proza :global(a:hover){color:var(--brand)}

  /* The only place the brand colour appears in prose — a quote is the one thing
     worth interrupting the column for. */
  .proza :global(blockquote){margin:0 0 20px;padding:2px 0 2px 18px;
    border-left:3px solid var(--brand);color:var(--ink)}
  .proza :global(blockquote p){margin:0 0 8px}
  .proza :global(blockquote p:last-child){margin:0}

  .proza :global(code){font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;
    font-size:14.5px;background:var(--surface);border:1px solid var(--line);
    border-radius:var(--r-sm);padding:1px 6px}
  .proza :global(pre){background:var(--surface);border:1px solid var(--line);
    border-radius:var(--r-md);padding:14px 16px;margin:0 0 18px;overflow-x:auto}
  .proza :global(pre code){background:none;border:0;padding:0;font-size:14px;line-height:1.6}

  .proza :global(img){display:block;width:100%;height:auto;border-radius:var(--r-md);
    border:1px solid var(--line);margin:22px 0}
  .proza :global(hr){border:0;border-top:1px solid var(--line);margin:32px 0}

  /* A wide table is the one thing that can force the whole page sideways, so it
     scrolls inside its own box instead. */
  .proza :global(table){width:100%;border-collapse:collapse;margin:0 0 20px;
    font-size:15px;display:block;overflow-x:auto}
  .proza :global(th),.proza :global(td){text-align:left;padding:9px 12px;
    border-bottom:1px solid var(--line)}
  .proza :global(th){color:var(--ink);font-weight:650;font-size:13px;
    text-transform:uppercase;letter-spacing:.04em}
  .proza :global(td){color:var(--muted)}
  .atpakal{margin-top:44px;font-size:14.5px}
  .atpakal a{color:var(--muted);text-decoration:none}
  .atpakal a:hover{color:var(--ink)}
</style>
