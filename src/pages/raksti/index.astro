---
import Base from '../../layouts/Base.astro';
import { allArticles, formatDate } from '../../lib/articles';

const raksti = await allArticles();

/**
 * Declare the list as a Blog so an answer engine reads it as a body of work
 * rather than a page of links, and can cite individual pieces. Omitted entirely
 * when there is nothing to describe — schema pointing at no content is an error,
 * not just dead weight.
 */
const schema = raksti.length
  ? [{
      '@context': 'https://schema.org',
      '@type': 'Blog',
      name: 'mai.lv raksti',
      url: 'https://mai.lv/raksti/',
      inLanguage: 'lv',
      author: { '@type': 'Person', name: 'Mārtiņš Auseklis' },
      blogPost: raksti.map((r) => ({
        '@type': 'BlogPosting',
        headline: r.data.virsraksts,
        description: r.data.kopsavilkums,
        datePublished: r.data.datums.toISOString(),
        url: `https://mai.lv/raksti/${r.id}/`,
        author: { '@type': 'Person', name: 'Mārtiņš Auseklis' },
      })),
    }]
  : [];
---
<Base
  title="Raksti — mai.lv"
  description="Raksti par mākslīgo intelektu un rīkiem, ko veidoju."
  schema={schema}
>
  <h1>Raksti</h1>

  {raksti.length === 0 && <p class="cap">Pirmais raksts drīzumā.</p>}

  <div class="arhivs">
    {raksti.map((r) => (
      <a class="ieraksts" href={`/raksti/${r.id}`}>
        <div class="d">{formatDate(r.data.datums)}</div>
        <div class="t">{r.data.virsraksts}</div>
        <div class="s">{r.data.kopsavilkums}</div>
      </a>
    ))}
  </div>
</Base>

<style>
  h1{margin-bottom:30px}
  .arhivs{max-width:var(--measure)}
  .ieraksts{display:block;text-decoration:none;color:inherit;padding:16px 0;
    border-bottom:1px solid var(--line)}
  .ieraksts:last-child{border-bottom:0}
  .ieraksts:hover .t{color:var(--accent)}
  .d{font-size:12.5px;color:var(--faint)}
  .t{font-family:var(--display);font-weight:600;font-size:18px;color:var(--ink);
    margin:4px 0 3px;line-height:1.3;transition:color var(--dur-fast) var(--ease-out)}
  .s{font-size:14.5px;color:var(--muted);line-height:1.5}
</style>
