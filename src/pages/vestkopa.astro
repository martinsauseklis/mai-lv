---
import Base from '../layouts/Base.astro';
import SignupForm from '../components/SignupForm.astro';
import t from '../content/lapas/vestkopa.json';
---
<Base
  title="Vēstkopa — mai.lv"
  description="Vēstkopa ar praktiskiem padomiem un noderīgiem MI rīkiem, kas palīdzēs atgūt tavu laiku."
>
  <h1>{t.virsraksts}</h1>
  <p class="sub">{t.apaksvirsraksts}</p>

  <SignupForm />

  <p class="cap arhivs-saite"><a href="/raksti">{t.arhivaSaite}</a></p>
</Base>

<style>
  h1{max-width:18ch;margin-bottom:16px}
  .sub{font-size:17.5px;color:var(--muted);max-width:46ch;margin-bottom:26px}
  .arhivs-saite{margin-top:40px}
</style>
