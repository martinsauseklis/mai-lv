---
import Base from '../layouts/Base.astro';
import { frontmatter, Content } from '../content/lapas/privacy.md';
import { hasContent } from '../lib/empty';
---
<Base
  title="Privātuma politika — mai.lv"
  description="Informācija par to, kā mai.lv apstrādā personas datus, piesakoties vēstkopai."
  noindex={true}
>
  <div class="policy">
    {hasContent(frontmatter.heading) && <h1>{frontmatter.heading}</h1>}
    {hasContent(frontmatter.effectiveFrom) && <p class="date">{frontmatter.effectiveFrom}</p>}
    <Content />
  </div>
</Base>

<style>
  /* The body arrives as rendered markdown, which Astro's scoping never touches —
     it only marks elements written in this file. Hence the wrapper and :global,
     the same arrangement an article page uses. */
  .policy :global(h1){margin-bottom:10px}
  .policy :global(.date){font-size:12.5px;color:var(--faint);margin-bottom:34px}
  .policy :global(h2){font-size:19px;margin:36px 0 10px}
  .policy :global(p), .policy :global(li){max-width:var(--measure);font-size:16.5px;line-height:1.75}
  .policy :global(ul){margin:0 0 14px;padding-left:20px;color:var(--muted)}
  .policy :global(li){margin:0 0 8px}
</style>
