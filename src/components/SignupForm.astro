---
/**
 * The EmailOctopus signup — the site's one conversion point, so it lives in one
 * file and both the home page and /vestkopa render this same component. The
 * styling below is hard-won against their embed; there must not be a second copy
 * of it to keep in sync.
 *
 * The fine print comes from the vestkopa singleton, so it stays editable in
 * Keystatic ("Vēstkopas lapa" → "Sīkais teksts zem formas") and reads the same
 * wherever the form appears.
 */
import vestkopa from '../content/lapas/vestkopa.json';

interface Props {
  /** Centre the form in its column — the home page is centred, /vestkopa is not. */
  center?: boolean;
}
const { center = false } = Astro.props;
---
<div class:list={['signup', { 'is-center': center }]}>
  <script
    async
    src="https://eocampaign1.com/form/dae5ac3e-90b7-11f1-855d-fdd3d718a2cb.js"
    data-form="dae5ac3e-90b7-11f1-855d-fdd3d718a2cb"></script>
  {vestkopa.smalkais && <p class="signup-fine">{vestkopa.smalkais}</p>}
</div>

<style is:global>
  /* ── EmailOctopus ──────────────────────────────────────────────────────
     Their embed exposes its whole theme as custom properties, so the fix is
     to point those at our tokens rather than fight the stylesheet with
     !important. Two things learned by reading the live DOM, both non-obvious:

       · they declare the variables TWICE — on .inline-container and again on
         the <form> — so setting them on the container alone gets overwritten
         further down. Hence both selectors.
       · [data-form] and .inline-container appear in the selectors only to
         out-specify their own rules. Nothing depends on the form id.

     Kept global because the embed injects its markup after hydration, so
     Astro's scoped-style attributes never reach it.
     ────────────────────────────────────────────────────────────────────── */
  .signup .inline-container[data-form],
  .signup .inline-container .emailoctopus-form{
    --font-family:var(--sans);
    --base-font-size:16px;             /* 16px is what stops iOS zooming on focus */
    --background-color:transparent;    /* no card — the page shows through */
    --border-color:transparent;
    --text-colour:var(--muted);
    --eo-form-font-color:var(--ink);
    --eo-form-placeholder:var(--muted);
    --label-colour:var(--muted);
    --label-size:12px;
    --field-colour:transparent;
    --field-border-colour:var(--line);
    --button-colour:var(--ink);
    --button-text-colour:var(--bg);
    --primary-brand-colour:var(--ink);
  }
  .signup .inline-container[data-form]{padding:0;border:0;box-shadow:none}

  /* Field and button must be the same height, and one number is what guarantees
     it. Their stylesheet is Bootstrap-derived: .form-control carries a FIXED
     height (calc(1.5em + .75rem + 2px) = 38px) so our padding never sized it,
     while the button was sized by our own min-height — 38 against 48. Both now
     take --signup-control-h and neither is sized by its padding. */
  .signup{--signup-control-h:48px}   /* also the comfortable thumb target */

  .signup .inline-container .form-control{
    height:var(--signup-control-h);padding:0 14px;
    border-radius:var(--r-sm);box-shadow:none;color:var(--ink);
    -webkit-text-fill-color:var(--ink);caret-color:var(--ink)}
  .signup .inline-container .form-control::placeholder{color:var(--muted);opacity:1}
  .signup .inline-container .form-control:focus{
    outline:none;box-shadow:none;border-color:var(--ink);color:var(--ink)}

  /* iOS, two separate problems invisible on a desktop browser: Safari paints
     autofilled text with -webkit-text-fill-color and ignores `color`, and it
     paints its own field background that `background` cannot override — the
     inset shadow is the only way to cover it. */
  .signup .inline-container .form-control:-webkit-autofill,
  .signup .inline-container .form-control:-webkit-autofill:focus{
    -webkit-text-fill-color:var(--ink);
    -webkit-box-shadow:0 0 0 1000px var(--bg) inset;
    caret-color:var(--ink)}

  /* inline-flex, not their inline-block: with the height fixed rather than
     grown by padding, only centring puts the label on the middle line. */
  .signup .inline-container .btn{
    height:var(--signup-control-h);min-height:var(--signup-control-h);
    display:inline-flex;align-items:center;justify-content:center;padding:0 18px;
    border-radius:var(--r-sm);font-weight:600;cursor:pointer}

  /* Their credit stays — the price of the free tier — but it whispers. The word
     is real text so it takes a colour; the octopus is a background-image on
     a::before, so it can only take a filter, and that filter must flip in dark
     mode or the mark disappears. */
  .signup .mastfoot p, .signup .mastfoot a{color:var(--faint);text-decoration:none}
  .signup .mastfoot a::before{filter:grayscale(1);opacity:.75}
  @media (prefers-color-scheme:dark){
    :root:not([data-theme="light"]) .signup .mastfoot a::before{filter:grayscale(1) invert(1)}
  }
  :root[data-theme="dark"] .signup .mastfoot a::before{filter:grayscale(1) invert(1)}

  /* Own layout is global too, so it sits in the same cascade as the rules above
     and the page around it needs no knowledge of the embed. */
  .signup{max-width:400px}
  .signup.is-center{margin-inline:auto;text-align:left}
  .signup .signup-fine{font-size:12.5px;color:var(--faint);margin:12px 0 0}
</style>
